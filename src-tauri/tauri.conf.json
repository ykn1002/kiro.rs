{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiro-rs",
  "version": "2026.9.3",
  "identifier": "rs.kiro.desktop",
  "build": {
    "frontendDist": "../admin-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
